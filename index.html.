<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lucky Spin</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      margin-top: 30px;
    }
    #wheel {
      width: 300px;
      height: 300px;
      border-radius: 50%;
      border: 10px solid #333;
      margin: 20px auto;
      position: relative;
      overflow: hidden;
      transition: transform 5s ease-out;
    }
    .segment {
      position: absolute;
      width: 50%;
      height: 50%;
      background: orange;
      transform-origin: 100% 100%;
      clip-path: polygon(0 0, 100% 0, 100% 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
    }
    #spinBtn {
      padding: 10px 20px;
      font-size: 18px;
      cursor: pointer;
      margin-top: 10px;
    }
    #nameInput {
      padding: 8px;
      font-size: 16px;
      width: 200px;
      margin-bottom: 10px;
    }
    #result {
      margin-top: 20px;
      font-size: 20px;
      font-weight: bold;
    }
    #history {
      margin-top: 30px;
      text-align: left;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }
    #history h3 {
      text-align: center;
    }
    #history ul {
      list-style: none;
      padding: 0;
    }
    #history li {
      background: #f0f0f0;
      padding: 8px;
      margin-bottom: 5px;
      border-radius: 5px;
    }
  </style>
</head>
<body>
  <h2>🎉 Lucky Spin 🎉</h2>

  <input type="text" id="nameInput" placeholder="Enter your name" />
  <br>
  <div id="wheel"></div>
  <button id="spinBtn">Spin Now</button>
  <div id="result"></div>

  <div id="history">
    <h3>Spin History</h3>
    <ul id="historyList"></ul>
  </div>

  <script>
    const prices = [140, 160, 180, 200, 220, 240];
    const wheel = document.getElementById("wheel");
    const spinBtn = document.getElementById("spinBtn");
    const result = document.getElementById("result");
    const nameInput = document.getElementById("nameInput");
    const historyList = document.getElementById("historyList");
    let spinning = false; // to prevent multiple spins at the same time

    // Draw segments
    prices.forEach((price, i) => {
      const seg = document.createElement("div");
      seg.className = "segment";
      seg.style.transform = `rotate(${(360 / prices.length) * i}deg) skewY(${90 - 360/prices.length}deg)`;
      seg.style.background = i % 2 === 0 ? "#FF5733" : "#C70039";
      seg.innerHTML = `<span style="transform: skewY(-${90 - 360/prices.length}deg) rotate(${180/prices.length}deg)">${price}</span>`;
      wheel.appendChild(seg);
    });

    spinBtn.addEventListener("click", () => {
      const name = nameInput.value.trim();
      if (!name) {
        alert("Please enter your name before spinning!");
        return;
      }
      if (spinning) return;
      spinning = true;
      spinBtn.disabled = true;
      spinBtn.innerText = "Spinning...";

      const randomIndex = Math.floor(Math.random() * prices.length);
      const deg = 360 * 5 + (360 / prices.length) * randomIndex + (360 / (prices.length * 2));

      wheel.style.transform = `rotate(${deg}deg)`;

      setTimeout(() => {
        const prize = prices[randomIndex];
        result.innerText = `🎁 Congratulations, ${name}! You got saffron at ₹${prize} 🎁`;

        // Add to history
        const li = document.createElement("li");
        li.innerText = `${name} won ₹${prize}`;
        historyList.prepend(li); // newest on top

        // Reset input and button for next person
        nameInput.value = "";
        spinBtn.disabled = false;
        spinBtn.innerText = "Spin Now";
        spinning = false;
      }, 5000);
    });
  </script>
</body>
</html>